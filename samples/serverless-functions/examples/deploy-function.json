{
  "action": "deploy",
  "cluster_name": "my-eks-cluster",
  "function": {
    "name": "hello-world",
    "image": "nginx:alpine",
    "port": 80,
    "replicas": {
      "min": 2,
      "max": 10
    },
    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "128Mi"
      },
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      }
    }
  }
}
